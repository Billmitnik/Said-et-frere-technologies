generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductCategory {
  computers
  displays
  accessories
  storage
  network
  bags

  @@map("product_category")
}

model Product {
  id              String          @id @db.VarChar(120)
  name            String          @db.VarChar(200)
  category        ProductCategory
  categoryLabel   String          @map("category_label") @db.VarChar(120)
  badge           String          @db.VarChar(80)
  description     String          @db.Text
  price           Int?
  art             String          @db.VarChar(40)
  mark            String          @db.VarChar(40)
  image           String          @db.VarChar(500)
  blendBackground Boolean         @default(false) @map("blend_background")
  pitch           String?         @db.Text
  isDemo          Boolean         @default(true) @map("is_demo")
  isActive         Boolean         @default(true) @map("is_active")
  sortOrder       Int             @default(0) @map("sort_order")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([isActive, sortOrder])
  @@map("products")
}

/// Photos uploaded from the admin page. A product's `image` points to one as
/// "photos/<id>"; the bytes never change for a given id, so they can be cached forever.
model ProductImage {
  id          String   @id @default(uuid()) @db.Uuid
  contentType String   @map("content_type") @db.VarChar(40)
  data        Bytes
  byteSize    Int      @map("byte_size")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("product_images")
}

/// Failed admin sign-ins, used to slow down password guessing per IP address.
model AdminLoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  ip        String   @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([ip, createdAt])
  @@map("admin_login_attempts")
}
