# Local development example. Replace these URLs with your own PostgreSQL credentials.
# Never commit real credentials. DIRECT_URL should point to the direct database endpoint
# for migrations; DATABASE_URL may use a pooler for the running application.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/said_freres?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/said_freres?schema=public"

# Admin area (/admin). In production DATABASE_URL uses a read-only role and
# ADMIN_DATABASE_URL a role that may insert and update products and photos (no delete).
# ADMIN_PASSWORD_HASH has the form "scrypt:<N>:<r>:<p>:<salt>:<hash>" (base64url parts).
# ADMIN_SESSION_SECRET is a random string of at least 32 characters.
ADMIN_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/said_freres?schema=public"
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_SECRET=""
